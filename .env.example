NODE_ENV=development
PORT=4100
# Public URL of the client app (CORS origin)
CLIENT_URL=http://localhost:5180
# Public URL of this server
SERVER_URL=http://localhost:4100
# Secret: MongoDB connection string (Atlas: mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority)
MONGO_URI=mongodb://127.0.0.1:27017/mokabla
# Secret: long random string: openssl rand -hex 32
SESSION_SECRET=change-me
# This username becomes Founder when it registers; everyone else signs up as Member. Leave empty normally.
FOUNDER_USERNAME=
# Protected owner: always Founder, can never be banned, disabled or demoted.
OWNER_USERNAME=
# 'lax' if client and API share a site (e.g. app.com + app.com/api); 'none' for different sites (HTTPS only)
COOKIE_SAMESITE=lax
# Signed-in users on a known VPN/proxy/datacenter IP can browse but not post.
VPN_BLOCK=true
VPN_LIST_URL=https://raw.githubusercontent.com/X4BNet/lists_vpn/main/output/vpn/ipv4.txt
# Secret (optional): key for hashing IPs. Empty = uses SESSION_SECRET.
IP_HASH_SECRET=
